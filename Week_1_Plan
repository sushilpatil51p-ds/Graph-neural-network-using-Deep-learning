Create ingest.py: Write the bulk-insertion script to handle batching (since graph files are large):Pythonimport pandas as pd
from neo4j import GraphDatabase

# Database connection URI
uri = "bolt://localhost:7687"
driver = GraphDatabase.driver(uri, auth=("", ""))

def ingest_data():
    print("Loading CSV files...")
    nodes_df = pd.read_csv("elliptic_txs_nodes.csv")
    classes_df = pd.read_csv("elliptic_txs_classes.csv")
    edges_df = pd.read_csv("elliptic_txs_edgelist.csv")

    # Merge nodes and classes
    nodes_df = pd.merge(nodes_df, classes_df, on="txId", how="left")
    nodes_df['class'] = nodes_df['class'].fillna("unknown")

    print("Inserting nodes into Memgraph...")
    with driver.session() as session:
        # Batch insert nodes using UNWIND
        query_nodes = """
        UNWIND $rows AS row
        CREATE (t:Transaction {id: row.txId, step: row.time_step, class: toString(row.class)})
        """
        # Insert in chunks of 5000 to prevent memory spikes
        chunk_size = 5000
        for i in range(0, len(nodes_df), chunk_size):
            chunk = nodes_df.iloc[i:i+chunk_size]
            rows = chunk.to_dict(orient="records")
            session.run(query_nodes, rows=rows)

    print("Inserting edges into Memgraph...")
    with driver.session() as session:
        query_edges = """
        UNWIND $rows AS row
        MATCH (source:Transaction {id: row.txId1})
        MATCH (target:Transaction {id: row.txId2})
        CREATE (source)-[:TRANSFERS_TO]->(target)
        """
        for i in range(0, len(edges_df), chunk_size):
            chunk = edges_df.iloc[i:i+chunk_size]
            rows = chunk.to_dict(orient="records")
            session.run(query_edges, rows=rows)

    print("Data ingestion completed successfully!")

if __name__ == "__main__":
    ingest_data()
