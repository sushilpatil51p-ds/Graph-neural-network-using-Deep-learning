# ==============================================================================
# GraphGuard AI — FinTech AML & PayPal AI Hackathon Environment Config
# ==============================================================================

# Google Gemini API key (Required for AI SAR & PayPal Compliance Audit reports)
# Free key available at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# PayPal Developer Sandbox Credentials
# Get your Sandbox App credentials at: https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID="your_sandbox_client_id_here"
PAYPAL_CLIENT_ID="your_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret_here"
PAYPAL_MODE="sandbox"

# Backend API Configuration
VITE_API_URL="http://localhost:3001"
API_PORT=3001
JWT_SECRET="graphguard-secret-change-in-production-2024"

# Application URL
APP_URL="http://localhost:3000"
