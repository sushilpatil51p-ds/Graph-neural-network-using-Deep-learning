# Gemini AI API key (browser-side — VITE_ prefix exposes it to the React bundle)
# Get a free key at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Backend API URL (defaults to localhost:3001 if not set)
VITE_API_URL="http://localhost:3001"

# Express backend settings (server-side only)
API_PORT=3001
JWT_SECRET="graphguard-secret-change-in-production"

# App URL (used for OAuth callbacks etc.)
APP_URL="http://localhost:3000"
